{
  "expo": {
    "name": "TriTrack",
    "slug": "tritrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tritrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#080C1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.facufuensa.tritrack",
      "appleTeamId": "RS6J29JLPS",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#080C1A"
      },
      "package": "com.facufuensa.tritrack"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#5E9FFF"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TriTrack usa el micrófono para grabar cómo te fue en el entrenamiento.",
          "speechRecognitionPermission": "TriTrack pasa tu audio a texto para que el coach lo lea."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "TriTrack usa el movimiento del teléfono para inclinar las medallas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2bdb2f94-b6bf-40f0-aea0-f4d853729907"
      }
    },
    "owner": "facundofuensa",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2bdb2f94-b6bf-40f0-aea0-f4d853729907"
    }
  }
}
